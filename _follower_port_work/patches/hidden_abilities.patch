+	@ Like givemon / giveegg, but the Pokemon has its species' hidden ability
+	@ (.hiddenAbility in src/data/pokemon/species_info.h; species without one get a normal ability).
+	.macro givemon_hidden species:req, level:req, item=ITEM_NONE
+	callnative ScriptSetNextGivenMonHiddenAbility
+	givemon \species, \level, \item
+	.endm
+
+	.macro giveegg_hidden species:req
+	callnative ScriptSetNextGivenMonHiddenAbility
+	giveegg \species
+	.endm
+
 	@ Replaces the move at 'slot' of the Pokémon in the player's party at 'partyIndex' with the specified move.
 	@ If a value greater than PARTY_SIZE is given for partyIndex it will use the last Pokémon in the party instead.
 	@ Note that this means in vanilla a value equal to PARTY_SIZE for partyIndex will go out of bounds.
@@ -1437,6 +1449,12 @@
 	.2byte \item
 	.endm
 
+	@ setwildbattle, with the Pokemon given its hidden ability (for static encounters).
+	.macro setwildbattle_hidden species:req, level:req, item=ITEM_NONE
+	setwildbattle \species, \level, \item
+	callnative ScriptSetWildMonHiddenAbility
+	.endm
+
 	@ Starts a wild battle against the Pokemon generated by setwildbattle. Blocks script execution until the battle finishes.
 	.macro dowildbattle
 	.byte 0xb7
