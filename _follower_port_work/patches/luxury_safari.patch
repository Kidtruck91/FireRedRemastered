diff --git a/data/maps/SixIsland_Safari_Entrance/scripts.inc b/data/maps/SixIsland_Safari_Entrance/scripts.inc
new file mode 100644
index 000000000..00e16525c
--- /dev/null
+++ b/data/maps/SixIsland_Safari_Entrance/scripts.inc
@@ -0,0 +1,220 @@
+SixIsland_Safari_Entrance_MapScripts::
+	map_script MAP_SCRIPT_ON_FRAME_TABLE, SixIsland_Safari_Entrance_OnFrame
+	.byte 0
+
+SixIsland_Safari_Entrance_OnFrame::
+	map_script_2 VAR_MAP_SCENE_SIX_ISLAND_SAFARI_ENTRANCE, 1, SixIsland_Safari_Entrance_EventScript_ExitWarpIn
+	map_script_2 VAR_MAP_SCENE_SIX_ISLAND_SAFARI_ENTRANCE, 2, SixIsland_Safari_Entrance_EventScript_ExitEarly
+	map_script_2 VAR_MAP_SCENE_SIX_ISLAND_SAFARI_ENTRANCE, 3, SixIsland_Safari_Entrance_EventScript_ExitWalkIn
+	.2byte 0
+
+@ When player runs out of balls mid-battle
+SixIsland_Safari_Entrance_EventScript_ExitWalkIn::
+	lockall
+	textcolor NPC_TEXT_COLOR_MALE
+	applymovement OBJ_EVENT_ID_PLAYER, SixIsland_Safari_Entrance_Movement_ApproachCounter
+	waitmovement 0
+	msgbox SixIsland_Safari_Entrance_Text_CatchFairShareComeAgain
+	closemessage
+	applymovement OBJ_EVENT_ID_PLAYER, SixIsland_Safari_Entrance_Movement_Exit2
+	waitmovement 0
+	special ExitSafariMode
+	setvar VAR_MAP_SCENE_SIX_ISLAND_SAFARI_ENTRANCE, 0
+	releaseall
+	end
+
+@ When player runs of out balls after catching a pokemon, or runs out of steps
+SixIsland_Safari_Entrance_EventScript_ExitWarpIn::
+	lockall
+	textcolor NPC_TEXT_COLOR_MALE
+	msgbox SixIsland_Safari_Entrance_Text_CatchFairShareComeAgain
+	closemessage
+	applymovement OBJ_EVENT_ID_PLAYER, SixIsland_Safari_Entrance_Movement_Exit
+	waitmovement 0
+	special ExitSafariMode
+	setvar VAR_MAP_SCENE_SIX_ISLAND_SAFARI_ENTRANCE, 0
+	releaseall
+	end
+
+@ When player re-enters the entrance building with balls/steps remaining
+SixIsland_Safari_Entrance_EventScript_ExitEarly::
+	lockall
+	textcolor NPC_TEXT_COLOR_MALE
+	msgbox SixIsland_Safari_Entrance_Text_GoingToLeaveSafariZoneEarly, MSGBOX_YESNO
+	goto_if_eq VAR_RESULT, NO, SixIsland_Safari_Entrance_EventScript_ReturnToSafariZone
+	msgbox SixIsland_Safari_Entrance_Text_PleaseReturnSafariBalls
+	closemessage
+	applymovement OBJ_EVENT_ID_PLAYER, SixIsland_Safari_Entrance_Movement_Exit
+	waitmovement 0
+	special ExitSafariMode
+	setvar VAR_MAP_SCENE_SIX_ISLAND_SAFARI_ENTRANCE, 0
+	releaseall
+	end
+
+SixIsland_Safari_Entrance_EventScript_ReturnToSafariZone::
+	msgbox SixIsland_Safari_Entrance_Text_GoodLuck
+	closemessage
+	applymovement OBJ_EVENT_ID_PLAYER, SixIsland_Safari_Entrance_Movement_ReEnter
+	waitmovement 0
+	warp MAP_SIX_ISLAND_SAFARI_1, 19, 49
+	waitstate
+	end
+
+SixIsland_Safari_Entrance_Movement_Exit::
+	walk_down
+	walk_down
+	step_end
+
+SixIsland_Safari_Entrance_Movement_ReEnter::
+	walk_up
+	step_end
+
+SixIsland_Safari_Entrance_Movement_Exit2::
+	walk_down
+	walk_down
+	step_end
+
+SixIsland_Safari_Entrance_Movement_ApproachCounter::
+	walk_down
+	delay_8
+	step_end
+
+SixIsland_Safari_Entrance_EventScript_EntryTriggerMid::
+	lockall
+	setvar VAR_TEMP_2, 0
+	goto SixIsland_Safari_Entrance_EventScript_AskEnterSafariZone
+	end
+
+SixIsland_Safari_Entrance_EventScript_EntryTriggerRight::
+	lockall
+	setvar VAR_TEMP_2, 1
+	goto SixIsland_Safari_Entrance_EventScript_AskEnterSafariZone
+	end
+
+SixIsland_Safari_Entrance_EventScript_EntryTriggerLeft::
+	lockall
+	setvar VAR_TEMP_2, 2
+	goto SixIsland_Safari_Entrance_EventScript_AskEnterSafariZone
+	end
+
+SixIsland_Safari_Entrance_EventScript_AskEnterSafariZone::
+	textcolor NPC_TEXT_COLOR_MALE
+	msgbox SixIsland_Safari_Entrance_Text_WelcomeToSafariZone
+	applymovement OBJ_EVENT_ID_PLAYER, Common_Movement_WalkInPlaceFasterRight
+	waitmovement 0
+	showmoneybox 0, 0
+	msgbox SixIsland_Safari_Entrance_Text_PlaySafariGameFor500, MSGBOX_YESNO
+	goto_if_eq VAR_RESULT, YES, SixIsland_Safari_Entrance_EventScript_TryEnterSafariZone
+	msgbox SixIsland_Safari_Entrance_Text_OkayPleaseComeAgain
+	goto SixIsland_Safari_Entrance_EventScript_ForcePlayerBack
+	end
+
+SixIsland_Safari_Entrance_EventScript_TryEnterSafariZone::
+	call SixIsland_Safari_Entrance_EventScript_CheckSpaceForMons
+	checkmoney 500
+	goto_if_eq VAR_RESULT, FALSE, SixIsland_Safari_Entrance_EventScript_NotEnoughMoney
+	msgbox SixIsland_Safari_Entrance_Text_WhichHabitat
+	closemessage
+	hidemoneybox
+	callnative LuxurySafari_ChooseHabitat
+	waitstate
+	goto_if_eq VAR_RESULT, 0x7F, SixIsland_Safari_Entrance_EventScript_CancelHabitat
+	showmoneybox 0, 0
+	removemoney 500
+	updatemoneybox
+	callnative LuxurySafari_BufferHabitatName
+	msgbox SixIsland_Safari_Entrance_Text_ThatllBe500WeOnlyUseSpecialBalls
+	textcolor NPC_TEXT_COLOR_NEUTRAL
+	playfanfare MUS_LEVEL_UP
+	message SixIsland_Safari_Entrance_Text_PlayerReceived30SafariBalls
+	waitfanfare
+	call EventScript_RestorePrevTextColor
+	msgbox SixIsland_Safari_Entrance_Text_CallYouOnPAWhenYouRunOut
+	closemessage
+	hidemoneybox
+	call_if_eq VAR_TEMP_2, 0, SixIsland_Safari_Entrance_EventScript_EnterSafariZoneMid
+	call_if_eq VAR_TEMP_2, 1, SixIsland_Safari_Entrance_EventScript_EnterSafariZoneRight
+	call_if_eq VAR_TEMP_2, 2, SixIsland_Safari_Entrance_EventScript_EnterSafariZoneLeft
+	special EnterSafariMode
+	setvar VAR_SAFARI_RETURN_POINT, 1
+	setvar VAR_MAP_SCENE_SIX_ISLAND_SAFARI_ENTRANCE, 2
+	warp MAP_SIX_ISLAND_SAFARI_1, 19, 49
+	waitstate
+	end
+
+SixIsland_Safari_Entrance_EventScript_CancelHabitat::
+	msgbox SixIsland_Safari_Entrance_Text_OkayPleaseComeAgain
+	goto SixIsland_Safari_Entrance_EventScript_ForcePlayerBack
+	end
+
+SixIsland_Safari_Entrance_EventScript_EnterSafariZoneRight::
+	applymovement OBJ_EVENT_ID_PLAYER, SixIsland_Safari_Entrance_Movement_EnterSafariZoneRight
+	waitmovement 0
+	return
+
+SixIsland_Safari_Entrance_EventScript_EnterSafariZoneMid::
+	applymovement OBJ_EVENT_ID_PLAYER, SixIsland_Safari_Entrance_Movement_EnterSafariZoneMid
+	waitmovement 0
+	return
+
+SixIsland_Safari_Entrance_EventScript_EnterSafariZoneLeft::
+	applymovement OBJ_EVENT_ID_PLAYER, SixIsland_Safari_Entrance_Movement_EnterSafariZoneLeft
+	waitmovement 0
+	return
+
+SixIsland_Safari_Entrance_EventScript_CheckSpaceForMons::
+	getpartysize
+	goto_if_ne VAR_RESULT, PARTY_SIZE, EventScript_Return
+	specialvar VAR_RESULT, IsThereRoomInAnyBoxForMorePokemon
+	goto_if_eq VAR_RESULT, TRUE, EventScript_Return
+	msgbox SafariZone_Text_ExcuseMeYourPCBoxIsFull
+	goto SixIsland_Safari_Entrance_EventScript_ForcePlayerBack
+	end
+
+SixIsland_Safari_Entrance_EventScript_NotEnoughMoney::
+	msgbox SixIsland_Safari_Entrance_Text_OopsNotEnoughMoney
+	goto SixIsland_Safari_Entrance_EventScript_ForcePlayerBack
+	end
+
+SixIsland_Safari_Entrance_EventScript_ForcePlayerBack::
+	closemessage
+	hidemoneybox
+	applymovement OBJ_EVENT_ID_PLAYER, SixIsland_Safari_Entrance_Movement_ForceBack
+	waitmovement 0
+	releaseall
+	end
+
+SixIsland_Safari_Entrance_Movement_ForceBack::
+	walk_down
+	step_end
+
+SixIsland_Safari_Entrance_Movement_EnterSafariZoneMid::
+	walk_up
+	walk_up
+	step_end
+
+SixIsland_Safari_Entrance_Movement_EnterSafariZoneRight::
+	walk_up
+	walk_left
+	walk_up
+	step_end
+
+SixIsland_Safari_Entrance_Movement_EnterSafariZoneLeft::
+	walk_up
+	walk_right
+	walk_up
+	step_end
+
+SixIsland_Safari_Entrance_EventScript_InfoAttendant::
+	lock
+	faceplayer
+	msgbox SixIsland_Safari_Entrance_Text_FirstTimeAtSafariZone, MSGBOX_YESNO
+	goto_if_eq VAR_RESULT, YES, SixIsland_Safari_Entrance_EventScript_ExplainSafariZone
+	msgbox SixIsland_Safari_Entrance_Text_SorryYoureARegularHere
+	release
+	end
+
+SixIsland_Safari_Entrance_EventScript_ExplainSafariZone::
+	msgbox SixIsland_Safari_Entrance_Text_ExplainSafariZone
+	release
+	end
diff --git a/data/maps/SixIsland_Safari_Entrance/text.inc b/data/maps/SixIsland_Safari_Entrance/text.inc
new file mode 100644
index 000000000..6ee71bd17
--- /dev/null
+++ b/data/maps/SixIsland_Safari_Entrance/text.inc
@@ -0,0 +1,78 @@
+SixIsland_Safari_Entrance_Text_WelcomeToSafariZone::
+    .string "Welcome to the LUXURY SAFARI!$"
+
+SixIsland_Safari_Entrance_Text_PlaySafariGameFor500::
+    .string "For just ¥500, you can hunt\n"
+    .string "POKéMON from the far-off HOENN\l"
+    .string "region.\p"
+    .string "You choose the habitat, and we\n"
+    .string "stock the safari to match!\p"
+    .string "Would you like to play?$"
+
+SixIsland_Safari_Entrance_Text_ThatllBe500WeOnlyUseSpecialBalls::
+    .string "The {STR_VAR_1} habitat it is!\n"
+    .string "That'll be ¥500, please!\p"
+    .string "We only use a special kind of\n"
+    .string "POKé BALLS here.$"
+
+SixIsland_Safari_Entrance_Text_PlayerReceived30SafariBalls::
+    .string "{PLAYER} received 30 SAFARI BALLS\n"
+    .string "from the attendant.$"
+
+SixIsland_Safari_Entrance_Text_CallYouOnPAWhenYouRunOut::
+    .string "We'll call you on the PA when you\n"
+    .string "run out of time or SAFARI BALLS.\p"
+    .string "Well, I'll wish you the best of\n"
+    .string "luck!$"
+
+SixIsland_Safari_Entrance_Text_OkayPleaseComeAgain::
+    .string "Okay.\n"
+    .string "Please come again!$"
+
+SixIsland_Safari_Entrance_Text_OopsNotEnoughMoney::
+    .string "Oops!\n"
+    .string "Not enough money!$"
+
+SixIsland_Safari_Entrance_Text_GoingToLeaveSafariZoneEarly::
+    .string "Are you going to leave the\n"
+    .string "LUXURY SAFARI early?$"
+
+SixIsland_Safari_Entrance_Text_PleaseReturnSafariBalls::
+    .string "Please return any SAFARI BALLS\n"
+    .string "you may have left.$"
+
+SixIsland_Safari_Entrance_Text_GoodLuck::
+    .string "Good luck!$"
+
+SixIsland_Safari_Entrance_Text_CatchFairShareComeAgain::
+    .string "Did you catch your fair share?\n"
+    .string "Come again!$"
+
+SixIsland_Safari_Entrance_Text_FirstTimeAtSafariZone::
+    .string "Hi! Is it your first time here at\n"
+    .string "the LUXURY SAFARI?$"
+
+SixIsland_Safari_Entrance_Text_ExplainSafariZone::
+    .string "Here at the LUXURY SAFARI, you\n"
+    .string "choose which habitat to hunt in.\p"
+    .string "FOREST, MEADOW, DESERT, VOLCANO,\n"
+    .string "JUNGLE, COAST or METEOR.\p"
+    .string "Each habitat brings its own\n"
+    .string "POKéMON to the grass and to the\l"
+    .string "water, where you can SURF or fish.\p"
+    .string "The attendant shows you which\n"
+    .string "POKéMON live in each habitat\l"
+    .string "before you pick.\p"
+    .string "Otherwise, it plays just like the\n"
+    .string "SAFARI ZONE in FUCHSIA.\p"
+    .string "Use the supplied SAFARI BALLS, and\n"
+    .string "throw BAIT or ROCKS as you like.\p"
+    .string "When you run out of time or SAFARI\n"
+    .string "BALLS, it's game over for you!$"
+
+SixIsland_Safari_Entrance_Text_SorryYoureARegularHere::
+    .string "Sorry, you're a regular here!$"
+
+SixIsland_Safari_Entrance_Text_WhichHabitat::
+    .string "Which habitat would you like\n"
+    .string "to hunt in today?$"
