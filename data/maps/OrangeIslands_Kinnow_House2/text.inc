OrangeIslands_Kinnow_House2_Text_OldWoman::
	.string "You can hear the cheering from\n"
	.string "here on a still night.\p"
	.string "All the way up from the water.$"

OrangeIslands_Kinnow_House2_Text_Youngster::
	.string "One day I will be old enough to\n"
	.string "go down there.\p"
	.string "Mum says the same thing every\n"
	.string "year.$"

