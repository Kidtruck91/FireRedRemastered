OrangeIslands_Kinnow_Massage_Text_Customer::
	.string "My GOLBAT has been one good mood\n"
	.string "away from something else for\l"
	.string "weeks.\p"
	.string "I have spent a fortune in here.\n"
	.string "I regret none of it.$"

OrangeIslands_Kinnow_Massage_Text_Girl::
	.string "A POKeMON that likes you fights\n"
	.string "harder. Everyone knows that.\p"
	.string "Not everyone knows some of them\n"
	.string "change shape over it.$"

OrangeIslands_Kinnow_Massage_Text_Menu::
	.string "Welcome to the KINNOW ROOMS.\p"
	.string "We groom POKeMON, and we are told\n"
	.string "we are very good at it.$"

OrangeIslands_Kinnow_Massage_Text_WhichMon::
	.string "Which one shall we see to?$"

OrangeIslands_Kinnow_Massage_Text_LieBack::
	.string "Lovely. This will take a little\n"
	.string "while.$"

OrangeIslands_Kinnow_Massage_Text_AllDone::
	.string "There. {STR_VAR_1} looks\n"
	.string "wonderful.\p"
	.string "And rather fond of you, if I may\n"
	.string "say so.$"

OrangeIslands_Kinnow_Massage_Text_NoMoney::
	.string "Oh dear. That is more than you\n"
	.string "have on you.$"

OrangeIslands_Kinnow_Massage_Text_Declined::
	.string "Another time, then.$"

OrangeIslands_Kinnow_Massage_Text_NotAnEgg::
	.string "I cannot groom an EGG!\p"
	.string "There is nothing to groom yet.$"

