OrangeIslands_Moro_GhostShip_Room_B1F_MapScripts::
	.byte 0

OrangeIslands_Moro_GhostShip_Room_B1F_EventScript_Voss::
	goto_if_defeated TRAINER_GHOST_SHIP_CAPTAIN_VOSS, OrangeIslands_Moro_GhostShip_Room_B1F_EventScript_VossAfter
	trainerbattle_single TRAINER_GHOST_SHIP_CAPTAIN_VOSS, OrangeIslands_Moro_GhostShip_Room_B1F_Text_VossIntro, OrangeIslands_Moro_GhostShip_Room_B1F_Text_VossDefeat, OrangeIslands_Moro_GhostShip_Room_B1F_EventScript_VossBeaten
	end

OrangeIslands_Moro_GhostShip_Room_B1F_EventScript_VossBeaten::
	msgbox OrangeIslands_Moro_GhostShip_Room_B1F_Text_VossPostBattle
	goto OrangeIslands_Moro_GhostShip_Room_B1F_EventScript_GiveHM08
	end

OrangeIslands_Moro_GhostShip_Room_B1F_EventScript_VossAfter::
	lock
	faceplayer
	goto_if_unset FLAG_GOT_HM08_FROM_VOSS, OrangeIslands_Moro_GhostShip_Room_B1F_EventScript_GiveHM08
	msgbox OrangeIslands_Moro_GhostShip_Room_B1F_Text_VossRepeat
	release
	end

OrangeIslands_Moro_GhostShip_Room_B1F_EventScript_GiveHM08::
	checkitemspace ITEM_HM08
	goto_if_eq VAR_RESULT, FALSE, OrangeIslands_Moro_GhostShip_Room_B1F_EventScript_VossNoRoom
	giveitem_msg OrangeIslands_Moro_GhostShip_Room_B1F_Text_ReceivedHM08, ITEM_HM08
	setflag FLAG_GOT_HM08_FROM_VOSS
	msgbox OrangeIslands_Moro_GhostShip_Room_B1F_Text_ExplainHM08
	release
	end

OrangeIslands_Moro_GhostShip_Room_B1F_EventScript_VossNoRoom::
	msgbox OrangeIslands_Moro_GhostShip_Room_B1F_Text_VossNoRoom
	release
	end

OrangeIslands_Moro_GhostShip_Room_B1F_EventScript_ItemTM30::
	finditem ITEM_TM30
	end

